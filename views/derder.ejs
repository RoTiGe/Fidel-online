<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html, body {
            width: 100%;
            height: 100%;
            background: #000; /* game backgrounds often dark */
        }

        /* Keep header visible and out of the game area */
        header {
            position: sticky;
            top: 0;
            z-index: 10;
        }

        /* Reserve vertical space below the header for the game iframe.
           Approximate header height to prevent overlap across devices. */
        .game-frame {
            width: 100%;
            height: calc(100vh - 120px);
            /* The 120px accounts for header height (title + nav + padding) */
        }

        iframe {
            width: 100%;
            height: 100%;
            border: none;
            display: block;
        }
    </style>
</head>
<body>
    <%- include('partials/header') %>
    <div class="game-frame">
        <iframe src="/geez_alphabet_derder/index.html" title="Derder Game"></iframe>
    </div>
    <script>
        (function() {
            function setFrameHeight() {
                var header = document.querySelector('header');
                var frame = document.querySelector('.game-frame');
                if (!header || !frame) return;
                var h = Math.ceil(header.getBoundingClientRect().height);
                frame.style.height = 'calc(100vh - ' + h + 'px)';
            }
            window.addEventListener('load', setFrameHeight);
            window.addEventListener('resize', setFrameHeight);
        })();
    </script>
</body>
</html>
