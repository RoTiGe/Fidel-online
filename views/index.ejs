<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <%- include('partials/head') %>
    <style>
        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 40px 20px;
        }

        .hero {
            text-align: center;
            color: white;
            margin-bottom: 60px;
        }

        .hero h1 {
            font-size: 3em;
            margin-bottom: 20px;
            text-shadow: 2px 2px 4px rgba(0,0,0,0.3);
        }

        .hero p {
            font-size: 1.3em;
            margin-bottom: 30px;
        }

        .games-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 30px;
            margin-top: 40px;
        }

        .game-card {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            border-radius: 15px;
            padding: 40px 30px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.2);
            transition: all 0.3s ease;
            text-align: center;
            cursor: pointer;
            text-decoration: none;
            display: block;
            color: white;
        }

        .game-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 40px rgba(0,0,0,0.3);
        }

        .game-card h2 {
            color: white;
            margin: 0;
            font-size: 2em;
        }

        .features {
            background: rgba(255,255,255,0.1);
            border-radius: 15px;
            padding: 40px;
            margin-top: 60px;
            color: white;
        }

        .features h2 {
            text-align: center;
            margin-bottom: 30px;
        }

        .features ul {
            list-style: none;
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 20px;
        }

        .features li {
            background: rgba(255,255,255,0.1);
            padding: 20px;
            border-radius: 10px;
            text-align: center;
        }
    </style>
</head>
<body>
    <%- include('partials/header') %>
    
    <div class="container">
        <div class="hero">
            <h1>🎮 Welcome to Fidel Games!</h1>
            <p>Learn the Geez (Ethiopic) Alphabet Through Fun Interactive Games</p>
        </div>

        <div class="games-grid">
            <a href="/mario-platformer" class="game-card">
                <h2>🌟 AbuGida</h2>
            </a>

            <a href="/platformer-tutorial" class="game-card">
                <h2>📚 Platformer Tutorial</h2>
            </a>

            <a href="/platformer" class="game-card">
                <h2>🏃 Platformer Game</h2>
            </a>

            <a href="/alphabet-game" class="game-card">
                <h2>🔤 Alphabet Game</h2>
            </a>

            <a href="/derder" class="game-card">
                <h2>🎯 Derder Game</h2>
            </a>
        </div>

        <div class="features">
            <h2>✨ Features</h2>
            <ul>
                <li>🎮 <strong>Multiple Game Modes</strong><br>Different ways to learn</li>
                <li>📱 <strong>Mobile Friendly</strong><br>Play on any device</li>
                <li>🔊 <strong>Audio Support</strong><br>Hear pronunciations</li>
                <li>🎨 <strong>Beautiful Graphics</strong><br>Engaging visuals</li>
                <li>📊 <strong>Progress Tracking</strong><br>Track your learning</li>
                <li>🌍 <strong>Free to Play</strong><br>No cost, just fun!</li>
            </ul>
        </div>
    </div>

    <%- include('partials/footer') %>
</body>
</html>
