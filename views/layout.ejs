<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/main.css">
    <%- include('partials/head') %>
</head>
<body>
    <%- include('partials/header') %>
    
    <main>
        <%- body %>
    </main>
    
    <%- include('partials/footer') %>
    <script>
        (function() {
            function labelFor(key) {
                var map = { amharic: 'Amharic', tigrinya: 'Tigrigna', oromo: 'Oromiffa', spanish: 'Spanish' };
                return map[key] || key;
            }

            function initLanguageSwitcher() {
                var select = document.getElementById('languageSelect');
                var status = document.getElementById('languageStatus');
                if (!select) return;
                var saved = localStorage.getItem('selectedLanguage') || 'amharic';
                select.value = saved;
                if (status) status.textContent = '(' + labelFor(saved) + ')';

                select.addEventListener('change', function(e) {
                    var key = e.target.value;
                    localStorage.setItem('selectedLanguage', key);
                    if (status) status.textContent = '(' + labelFor(key) + ')';

                    var iframes = document.querySelectorAll('iframe');
                    if (iframes.length) {
                        iframes.forEach(function(f) {
                            try { f.contentWindow.location.reload(); }
                            catch (_) { f.src = f.src; }
                        });
                    } else {
                        // For pages that include translations directly, refresh to apply change
                        window.location.reload();
                    }
                });
            }

            window.addEventListener('DOMContentLoaded', initLanguageSwitcher);
        })();
    </script>
</body>
</html>
